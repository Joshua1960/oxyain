{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true })\" && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "next start",
    "clean": "node -e \"const fs = require('fs'); ['.next', 'dist', 'server.js'].forEach(p => fs.rmSync(p, { recursive: true, force: true }))\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/game/rules.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@next/swc-wasm-nodejs": "^16.4.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "next": "^15.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "unpdf": "^2.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
